# Copy to .env and fill in. Never commit the real .env (it holds the
# device key).

BASE_URL=https://YOUR-APP-DOMAIN
DEVICE_KEY=bk_...

# GPIO pin numbers (BCM numbering) — adjust to match your wiring.
FEEDER_MOTOR_PIN=17
FEEDER_SENSOR_PIN=27
HOPPER_SENSOR_PIN=22

# How long to run the feed motor per card, and how long to wait for the
# card to reach the lane sensor before declaring a jam. Tune both with
# scripts/feeder_calibrate.py once the feeder is built.
FEED_PULSE_SECONDS=0.35
FEED_TIMEOUT_SECONDS=2.0

# Settle time after the feeder stops, before the shutter fires.
SETTLE_SECONDS=0.25

CAPTURE_DIR=/tmp/bulkscan

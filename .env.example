# Copy to .env and fill in. Never commit the real .env (it holds the
# device key).

BASE_URL=https://YOUR-APP-DOMAIN
DEVICE_KEY=bk_...

# GPIO pin numbers (BCM numbering) — the bucket rig was wired to these,
# don't change unless the wiring changes.
FEEDER_MOTOR_PIN=17
FEEDER_EXIT_SENSOR_PIN=27
HOPPER_SENSOR_PIN=22

# Both sensors are bench-verified to output <=3.3V in both states.
# Active-low (card=LOW) is expected but NOT yet confirmed end-to-end on
# the Pi — that's the first thing scripts/feeder_calibrate.py's monitor
# mode establishes. If it shows a sensor's interpreted state backwards
# from its raw level, flip the corresponding value here (true/false) —
# no code change needed for a polarity mismatch.
HOPPER_SENSOR_ACTIVE_LOW=true
FEEDER_EXIT_SENSOR_ACTIVE_LOW=true

# --- Feed timing — ALL OF THIS MUST BE TUNED ON THE REAL MACHINE ---
# Starting points only, not measured values. Use scripts/feeder_calibrate.py.

# How long to run the feed motor per card. One pulse now has to carry a
# card from the retard gate, across the deck, and over the edge — a
# longer throw than a simple lane feed. Start in the 0.55-0.75s range
# and tune from there.
FEED_PULSE_SECONDS=0.65

# How long to wait for the exit sensor to trip (card entering the arch)
# and, separately, to clear (card leaving the arch) before declaring a
# misfeed/jam. 2.0s leaves margin even at the top of the pulse range
# above (2x a 0.75s pulse is 1.5s) — revisit if you tune the pulse
# higher than that.
FEED_TIMEOUT_SECONDS=2.0

# Settle time after the exit sensor clears, before the shutter fires.
# NOT YET MEASURED. The card free-falls off the deck and tumbles into
# the bucket before it stops moving — this is a real fall-and-settle
# time, not the brief mechanical settle of a lane feed, and is almost
# certainly longer than the placeholder below. There is no safe default
# to ship here; measure it (watch captured frames for motion blur /
# mid-tumble shots and increase until they stop) before running a real
# job. The rig will refuse to start without this set.
SETTLE_SECONDS=

# --- Bucket capacity ---
# How many cards can land in the bucket before the pile gets close
# enough to the camera's 100mm minimum focus distance to risk soft
# focus. NOT YET VERIFIED for this rig — do not guess from card
# thickness, measure it (or get a verified number) before running a
# real job. The rig pauses and prompts to empty the bucket once this
# count is reached, and refuses to start without it set.
BUCKET_CAPACITY_CARDS=

# --- Camera / vision pipeline ---
# Re-run autofocus every N cards. Distance to the top card shrinks from
# ~160mm (empty bucket) to ~113.5mm (full) over a run, so 1 (every
# shot) is the safe default. Raising this trades focus accuracy for
# capture speed if per-shot AF can't keep up with the 1-2 photos/sec
# pacing target.
REFOCUS_EVERY_CARDS=1

# Software rotation applied at capture time, on top of whatever the
# physical 90-degree camera mount already does. Default 0 (no-op) —
# it's unverified from here whether raw frames need this at all. Check
# during bring-up (the camera-check step) and set to 90/180/270 only if
# raw frames actually come out sideways.
CAMERA_ROTATION_DEGREES=0

# Frame-diff sensitivity (0-255) used to isolate the newest card from
# the rest of the pile between consecutive photos. Software tuning
# knob, not a hardware measurement — watch the cropped output in
# CAPTURE_DIR and adjust if cards are being mis-cropped or missed.
CARD_DIFF_THRESHOLD=30

# Long side, in pixels, of the cropped/deskewed card image actually
# uploaded (matches the contract's 1200-1600px recommendation).
CARD_OUTPUT_LONG_SIDE_PX=1500

CAPTURE_DIR=/tmp/bulkscan
